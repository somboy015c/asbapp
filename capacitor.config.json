{
  "appId": "com.asbdataghana.app",
  "appName": "ASBData Ghana",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#171B57",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT"
    }
  }
}
